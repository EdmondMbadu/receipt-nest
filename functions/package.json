{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:email-pdf": "npm run build && RUN_EMAIL_PDF_TEST=1 node --test test/email-renderer.integration.test.cjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/documentai": "^8.12.0",
    "@google-cloud/vertexai": "^1.9.0",
    "@sendgrid/mail": "^8.1.4",
    "@sparticuz/chromium": "153.0.0",
    "busboy": "1.6.0",
    "cheerio": "1.2.0",
    "dotenv": "^16.3.1",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^7.0.6",
    "heic-decode": "^2.1.0",
    "ipaddr.js": "2.3.0",
    "mailparser": "3.14.2",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "25.16.0",
    "sanitize-html": "2.18.1",
    "sharp": "^0.34.5",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5",
    "@types/mailparser": "3.9.0",
    "@types/sanitize-html": "2.16.2",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.7.3"
  },
  "private": true
}
