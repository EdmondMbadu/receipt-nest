# Local generated media and production artifacts
/Claude outputs/
/artifacts/

# Local tool caches and sessions
/.firebase/
/.npm-cache/
/:memory:.ses
__pycache__/
*.pyc

# System files
.DS_Store
Thumbs.db

# Environment files with sensitive data
environments/environments.ts
